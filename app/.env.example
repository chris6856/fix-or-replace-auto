# Copy this file to .env and fill in real values. Never commit .env.
#
# Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Use the "Web application" client ID here (needed to obtain an idToken),
# even though the app itself is native. Leave blank to hide the Google
# sign-in button until this is configured.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple Sign In needs no client ID in app code -- it uses this app's bundle
# identifier (see app.json ios.bundleIdentifier) registered in the Apple
# Developer Program, plus the "Sign in with Apple" provider configured in
# the Supabase dashboard (Services ID + private key), not here.
