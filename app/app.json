{
  "expo": {
    "name": "Fix or Replace Auto",
    "slug": "fix-or-replace-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixorreplaceauto.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fixorreplaceauto.app",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#0A0F2E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Fix or Replace Auto uses your camera to scan a vehicle's VIN barcode."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fix or Replace Auto uses your photo library to add a picture of your vehicle."
        }
      ]
    ]
  }
}
