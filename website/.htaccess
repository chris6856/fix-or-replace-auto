# Force HTTPS and the canonical (non-www) host.
#
# The /estimate/ guest checkout flow stores its in-progress numbers in
# sessionStorage before redirecting to Stripe, then reads them back after
# the payment completes. sessionStorage is scoped per-origin (scheme +
# host), and Stripe's success_url always lands the visitor back on
# https://fixorreplaceauto.com (no www) -- so a visitor who started the
# flow on http:// or www.fixorreplaceauto.com returns to a DIFFERENT
# origin with empty storage, silently losing their result even though
# they paid. Forcing every visitor onto one canonical origin up front
# prevents that entirely (and is good practice regardless).
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.fixorreplaceauto\.com$ [NC]
RewriteRule ^(.*)$ https://fixorreplaceauto.com/$1 [L,R=301]

# Redirect any request for a literal "index.html" (root or a subdirectory,
# e.g. /index.html or /estimate/index.html) to the clean directory URL.
# Apache already serves index.html as the default document either way, so
# this doesn't change what's shown -- it just stops Google from treating
# the two URLs as separate, duplicate pages (flagged in Search Console:
# "/index.html" indexed as a near-duplicate of "/" with no canonical
# chosen). A 301 is a hard signal here, stronger than rel=canonical alone.
RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
