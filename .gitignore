# Native projects are generated by `expo prebuild` (Continuous Native
# Generation) -- not committed, regenerated from app.json + plugins.
app/ios/
app/android/

# Release signing -- NEVER commit a keystore or its passwords. Losing this
# keystore means losing the ability to ever publish an update to the same
# Play Store listing, so back it up somewhere durable outside git instead.
android-signing/
*.keystore
*.jks
keystore.properties

